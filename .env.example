# MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.example.mongodb.net/akademix?retryWrites=true&w=majority

# Secret key used to sign and verify JSON Web Tokens (use a long, random secret in production)
JWT_SECRET=your_jwt_secret_key_min_32_characters_long

# Cloudinary credentials for enquiry document uploads
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
